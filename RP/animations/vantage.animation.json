{
	"format_version": "1.10.0",
	"animations": {
		"animation.vantage.body.close": {
			"loop": true,
			"bones": {
				"root": {
					"rotation": [
						0,
						"q.is_in_ui || q.is_riding || q.is_swimming || q.is_sleeping || q.is_emoting ? 0 : q.target_y_rotation",
						0
					]
				},
				"head": {
					"scale": "q.is_in_ui ? 1.0 : 0.0"
				},
				"cape": {
					"scale": "q.is_in_ui || q.is_pack_setting_enabled('vantage:show_cape') ? 1.0 : 0.0"
				},
				"waist": {
					"position": [
						0,
						"q.is_in_ui || q.is_swimming ? 0 : (-2 + (q.target_x_rotation < 0 ? q.target_x_rotation / 15 : 0) + (q.is_sneaking ? -3 : 0) + q.get_pack_setting('vantage:body_up'))",
						"q.is_in_ui || q.is_swimming ? 0 : (5.5 + q.get_pack_setting('vantage:body_back'))"
					]
				},
				"leftLeg": {
					"position": [
						0,
						"q.is_in_ui || q.is_swimming ? 0 : (-2 + (q.target_x_rotation < 0 ? q.target_x_rotation / 15 : 0) + (q.is_sneaking ? -3 : 0) + q.get_pack_setting('vantage:body_up'))",
						"q.is_in_ui || q.is_swimming ? 0 : (5.5 + q.get_pack_setting('vantage:body_back'))"
					]
				},
				"rightLeg": {
					"position": [
						0,
						"q.is_in_ui || q.is_swimming ? 0 : (-2 + (q.target_x_rotation < 0 ? q.target_x_rotation / 15 : 0) + (q.is_sneaking ? -3 : 0) + q.get_pack_setting('vantage:body_up'))",
						"q.is_in_ui || q.is_swimming ? 0 : (5.5 + q.get_pack_setting('vantage:body_back'))"
					]
				},
				"rightItem": {
					"position": [
						"!q.is_in_ui && q.is_item_name_any('slot.weapon.mainhand', 'minecraft:heavy_core') ? 1 : 0",
						0,
						"!q.is_in_ui && q.is_item_name_any('slot.weapon.mainhand', 'minecraft:heavy_core') ? 2 : 0"
					]
				}
			}
		},
