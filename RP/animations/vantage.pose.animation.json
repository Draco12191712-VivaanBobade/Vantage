{
	"format_version": "1.26.0",
	"animations": {
		"animation.vantage.hide_head": {
			"loop": true,
			"bones": {
				"head": {
					"scale": 0.0
				}
			}
		},
		"animation.vantage.idle_sway": {
			"loop": true,
			"anim_time_update": "query.life_time",
			"bones": {
				"rightarm": {
					"rotation": [
						"math.sin(query.anim_time * 40.0) * 0.6 * (1.0 - query.is_in_ui)",
						0.0,
						0.0
					]
				},
				"leftarm": {
					"rotation": [
						"math.sin(query.anim_time * 40.0 + 180.0) * 0.6 * (1.0 - query.is_in_ui)",
						0.0,
						0.0
					]
				}
			}
		}
	}
}