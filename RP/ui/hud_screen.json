			15,
			15
		],
		"visible": false,
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "vantage_xh_data",
				"source_property_name": "((#vantage_xh_text - '§v§u§t') = '§1')",
				"target_property_name": "#visible"
