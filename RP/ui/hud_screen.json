{
	"namespace": "hud",
	"vantage_xh_data": {
		"type": "panel",
		"size": [
			0,
			0
		],
		"$vantage_xh_key": "§v§u§t",
		"bindings": [
			{
				"binding_name": "#hud_title_text_string"
			},
			{
				"binding_name": "#hud_title_text_string",
				"binding_name_override": "#vantage_xh_text",
				"binding_condition": "visibility_changed"
			},
			{
				"binding_type": "view",
				"source_property_name": "(not (#hud_title_text_string = #vantage_xh_text) and not ((#hud_title_text_string - $vantage_xh_key) = #hud_title_text_string))",
				"target_property_name": "#visible"
			}
		]
	},
